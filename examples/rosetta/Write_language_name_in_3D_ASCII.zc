import "std/string.zc"

def Z = """
  ____________           
  |\\           \\         
  | \\_______    \\        
  \\ |      /    /|       
   \\|_____/    / |       
         /    /_/______  
        |\\             \\ 
        | \\_____________\\
        \\ |             |
         \\|_____________|
""";


def E = """

    ___________      
   /   _____   \\     
  /   /_____\\   \\    
 |\\       _____/|    
 | \\     /|____|/    
 \\  \\    \\/_______/\\ 
  \\  \\_____________/|
   \\ |            | |
    \\|____________|/ 
""";

def N = """

  _____  _______       
 |\\__  \\/       \\      
 || |\\      __   \\    
 \\|_| \\    /| \\   \\   
    \\  \\   \\/\\ \\   \\  
     \\  \\   \\ \\ \\   \\ 
      \\  \\___\\ \\ \\___\\
