import "std/string.zc"

def Z = """
  ____________           
  |`           `         
  | `_______    `        
  ` |      /    /|       
   `|_____/    / |       
         /    /_/______  
        |`             ` 
        | `_____________`
        ` |             |
         `|_____________|
""";


def E = """

    ___________      
   /   _____   `     
  /   /_____`   `    
 |`       _____/|    
 | `     /|____|/    
 `  `    `/_______/` 
  `  `_____________/|
   ` |            | |
    `|____________|/ 
""";

def N = """

  _____  _______       
 |`__  `/       `      
 || |`      __   `    
 `|_| `    /| `   `   
    `  `   `/` `   `  
     `  `   ` ` `   ` 
      `  `___` ` `___`
       ` |   |  `|   |
        `|___|   |___|
""";

def C = """

       ___________       
      /           `     
     /      _______`    
    |`     /|______|    
    | `    `/           
    `  `    `________/` 
     `  `_____________/|
      ` |            | |
       `|____________|/ 
""";

fn main() {
    let z = String::from(Z).replace("`", "\\").split('\n');
    let e = String::from(E).replace("`", "\\").split('\n');
    let n = String::from(N).replace("`", "\\").split('\n');
    let c = String::from(C).replace("`", "\\").split('\n');
    for i in 0..11 {
        println "{z[i]}{e[i]}{n[i]} {c[i]}";
    }
}
